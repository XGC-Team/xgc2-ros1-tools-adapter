<?xml version="1.0"?>
<package format="2">
  <name>xgc_ros1_tools_adapter</name>
  <version>0.2.0</version>
  <description>Generic typed ROS1 tools exposed through XGC2 Adapter Runtime capabilities.</description>

  <maintainer email="lxk36@users.noreply.github.com">XGC2</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>ros_babel_fish</depend>
  <depend>roscpp</depend>
  <depend>roslib</depend>
  <build_depend>libjsoncpp-dev</build_depend>
  <build_depend>libxgc2-adapter-runtime-client-dev</build_depend>
  <exec_depend>libjsoncpp1</exec_depend>
  <exec_depend>libxgc2-adapter-runtime-client2</exec_depend>

  <test_depend>geometry_msgs</test_depend>
  <test_depend>rostest</test_depend>
  <test_depend>std_msgs</test_depend>
  <test_depend>std_srvs</test_depend>
</package>
