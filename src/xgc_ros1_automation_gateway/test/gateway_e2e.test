<launch>
  <node pkg="xgc_ros1_automation_gateway"
        type="xgc_ros1_automation_gateway_node"
        name="xgc_ros1_automation_gateway"
        args="--socket /tmp/xgc_ros1_automation_gateway_e2e.sock"
        output="screen"
        required="true">
    <!-- XGC2 process templates pass both optional network variables. An empty
         ROS_HOSTNAME must not override the configured ROS_IP in roscpp. -->
    <env name="ROS_IP" value="127.0.0.1"/>
    <env name="ROS_HOSTNAME" value=""/>
  </node>

  <test test-name="xgc_ros1_automation_gateway_e2e"
        pkg="xgc_ros1_automation_gateway"
        type="xgc_ros1_automation_gateway_e2e_tests"
        time-limit="120.0"/>
</launch>
